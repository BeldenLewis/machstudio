// ⚠ `prisma db push` 를 실행하면 **반드시** 아래를 이어서 실행할 것:
//
//     node scripts/ensure-partial-unique-indexes.mjs --apply
//
// 이 스키마에는 표현할 수 없는 "조건부 유니크 제약"이 10개 있다(팝업·투표·설문·Tally·공지의
// '웨비나당 활성 1개', Q&A 송출, 채팅 고정, 등록자 이메일·전화 중복 방지,
// 사전등록 수집 소스당 이메일 중복 방지).
// @@unique 에는 WHERE 를 붙일 수 없어 SQL 로 만들었고, db push 는 그것들을 스키마에 없는
// 잔재로 보고 **지운다**. 지워져도 에러는 안 나고, 라이브 중 동시 조작에서만 사고가 난다.
// 점검만: node scripts/ensure-partial-unique-indexes.mjs

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  avatarUrl    String?
  isSuperAdmin Boolean   @default(false)
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships          WorkspaceMember[]
  utmLinks             UTMLink[]
  shortLinks           ShortLink[]
  notifications        Notification[]
  sentInvitations      WorkspaceInvitation[]      @relation("InvitedBy")
  receivedInvitations  WorkspaceInvitation[]      @relation("InvitedUser")
  activityLogs         ActivityLog[]              @relation("ActivityActor")
  apiTokens            ApiToken[]
  notificationPrefs    NotificationPref[]
  projectMemberships   ProjectMember[]
  adPerformanceImports AdPerformanceImportBatch[] @relation("AdPerformanceUploader")
}

model Workspace {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// 등록 폼 약관 전문 템플릿 — 웨비나마다 다시 붙여넣을 값이 아니라 워크스페이스 자산이다.
  /// 웨비나가 자기 값을 비워 두면 이 값을 상속하고, 채워 두면 그 웨비나만 덮어쓴다.
  /// null = 아직 설정 안 함(기존 웨비나 값은 그대로 살아 있다 — 이 컬럼은 순수 추가다).
  privacyBodyTemplate   String?
  marketingBodyTemplate String?
  /// 법률 문구 생성기(legal-templates)의 조직 정보 — 회사명·주소·개인정보 담당 연락처.
  /// 위 두 필드와 같은 이유로 워크스페이스 자산이다. { default: OrgProfile, byCountry?: {...} }
  /// 모양(WorkspaceLegalProfile, src/lib/legal-templates/types.ts). null = 아직 설정 안 함.
  legalProfile Json?

  members              WorkspaceMember[]
  projects             Project[]
  utmLinks             UTMLink[]
  shortLinks           ShortLink[]
  utmPresets           UTMPreset[]
  utmTemplates         UTMTemplate[]
  invitations          WorkspaceInvitation[]
  collectSources       CollectSource[]
  collectRecords       CollectRecord[]
  activityLogs         ActivityLog[]
  dashboardWidgets     DashboardWidget[]
  dashboards           Dashboard[]
  scheduledReports     ScheduledReport[]
  apiTokens            ApiToken[]
  webinars             Webinar[]
  webinarEmbedSites    WebinarEmbedSite[]
  adPerformanceImports AdPerformanceImportBatch[]
  adPerformanceRecords AdPerformanceRecord[]
  competitions         Competition[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  role        Role     @default(MEMBER)
  userId      String
  workspaceId String
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model WorkspaceInvitation {
  id            String   @id @default(cuid())
  workspaceId   String
  invitedUserId String? // null 이면 미가입자 이메일 초대
  invitedEmail  String? // 이메일 기반 초대 시 사용 (가입 시 매칭)
  invitedById   String
  role          Role     @default(MEMBER)
  status        String   @default("PENDING") // PENDING | ACCEPTED | DECLINED
  token         String?  @unique // 이메일 링크용 — null 이면 인앱 초대
  createdAt     DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedUser User?     @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, invitedUserId])
  @@index([invitedEmail, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "WORKSPACE_INVITE" | "ROLE_CHANGED" | "MEMBER_REMOVED"
  data      Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id                         String    @id @default(cuid())
  name                       String
  description                String?
  workspaceId                String
  deletedAt                  DateTime?
  analyticsShareToken        String?   @unique
  analyticsShareEnabled      Boolean   @default(false)
  analyticsSharePasswordHash String?
  dashboardShareToken        String?   @unique
  dashboardShareEnabled      Boolean   @default(false)
  dashboardSharePasswordHash String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  workspace            Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  utmLinks             UTMLink[]
  collectSources       CollectSource[]
  collectRecords       CollectRecord[]
  dashboardWidgets     DashboardWidget[]
  dashboards           Dashboard[]
  projectMembers       ProjectMember[]
  webinars             Webinar[]
  webinarEmbedSites    WebinarEmbedSite[]
  adPerformanceImports AdPerformanceImportBatch[]
  adPerformanceRecords AdPerformanceRecord[]
  competitions         Competition[]
}

model AdPerformanceImportBatch {
  id           String    @id @default(cuid())
  workspaceId  String
  projectId    String
  uploadedById String?
  sourceType   String
  sourceName   String?
  fileName     String
  rowCount     Int       @default(0)
  reportStart  DateTime?
  reportEnd    DateTime?
  createdAt    DateTime  @default(now())

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?                 @relation("AdPerformanceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  records    AdPerformanceRecord[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
}

model AdPerformanceRecord {
  id                String    @id @default(cuid())
  batchId           String
  workspaceId       String
  projectId         String
  sourceType        String
  campaignName      String
  adGroupName       String?
  reportDate        DateTime?
  reportStart       DateTime?
  reportEnd         DateTime?
  status            String?
  currency          String?
  cost              Float?
  impressions       Int?
  reach             Int?
  clicks            Int?
  cpm               Float?
  cpc               Float?
  ctr               Float?
  conversions       Float?
  costPerConversion Float?
  conversionRate    Float?
  resultType        String?
  resultBucket      String?
  raw               Json
  createdAt         DateTime  @default(now())

  batch     AdPerformanceImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([projectId, reportDate])
  @@index([projectId, campaignName])
  @@index([projectId, resultBucket])
}

model UTMPreset {
  id          String   @id @default(cuid())
  workspaceId String
  field       String // "source" | "medium" | "campaign"
  value       String
  label       String? // 기본 모드 드롭다운에 표시될 이름 (예: "구글" → value: "google")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, field, value])
}

model UTMTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  source      String
  medium      String
  campaign    String?
  term        String?
  content     String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CollectSource {
  id               String    @id @default(cuid())
  projectId        String
  workspaceId      String
  name             String
  description      String?
  apiKey           String    @unique @default(cuid())
  siteUrl          String?
  successTrigger   String    @default("정상적으로 접수되었습니다")
  redirectUrl      String?
  isActive         Boolean   @default(true)
  discoveredFields Json?
  webhookUrl       String?
  notifyOnSubmit   Boolean   @default(false)
  allowedOrigins   String[]  @default([])
  formPagePatterns String[]  @default([])
  dedupKeyFields   String[]  @default([])
  /// 연동형(capture)이 필드 하나를 감지할 때 묶음으로 보는 CSS 선택자. 기본값은 아임웹 폼
  /// 빌더가 항상 넣는 ".form-group" — 그 밖의 사이트(직접 만든 신청서 등)는 이 값을
  /// 그 사이트에 맞는 선택자(예: 표 형태면 "table tr")로 바꿔야 필드가 잡힌다.
  fieldGroupSelector String  @default(".form-group")
  /// 수집 방식 — "capture"(외부 폼에 스크립트를 붙여 가로챔, 기존) | "builder"(여기서 폼을 만들어 렌더).
  /// formConfig 가 비었는지로 유추하지 않는다 — 빌더형인데 아직 문항을 안 채운 상태와 구분이 안 된다.
  /// 기본값이 capture 라 기존 소스는 전부 그대로 동작한다(백필 불필요).
  mode             String    @default("capture")
  /// 미리보기 링크 /p/{token}. 소스 id 를 그대로 노출하지 않는 이유는 **재발급으로 링크를 끊기 위해서**다
  /// (Project.analyticsShareToken 과 같은 패턴).
  previewToken     String?   @unique
  /// 문항·개요·안내·검증·동의·완료·등록확인. 스키마와 정규화는 src/lib/collect-form-config.ts.
  formConfig       Json?
  /// 발신·제목·본문·QR 첨부 설정.
  emailConfig      Json?
  /// 개최일·게이트·배지 등 현장 운영 설정.
  venueConfig      Json?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fieldMappings FieldMapping[]
  records       CollectRecord[]
  activityLogs  ActivityLog[]
}

model FieldMapping {
  id         String   @id @default(cuid())
  sourceId   String
  index      Int
  key        String
  label      String
  type       String   @default("text") // text | select | checkbox | radio
  isRequired Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  source CollectSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, index])
  @@unique([sourceId, key])
}

model CollectRecord {
  id               String    @id @default(cuid())
  sourceId         String
  projectId        String
  workspaceId      String
  data             Json
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  utmId            String?
  // first-touch attribution (최초 유입 시점의 UTM)
  firstUtmSource   String?
  firstUtmMedium   String?
  firstUtmCampaign String?
  firstUtmTerm     String?
  firstUtmContent  String?
  firstUtmId       String?
  firstReferrer    String?
  firstSeenAt      DateTime?
  // multi-touch journey (touchpoint 시계열, 최대 20개)
  journey          Json?
  referrer         String?
  userAgent        String?
  ip               String?
  /// 13자리 무작위 등록번호. 순차로 하면 등록 규모가 노출되고 남의 번호를 추측할 수 있다.
  registrationNo   String?   @unique
  /// 소문자·trim 한 이메일 — 중복 판정과 등록 확인 조회의 키.
  /// 유니크는 (sourceId, emailNormalized) **부분 인덱스**라 raw SQL 로만 만든다
  /// (Prisma 가 부분 인덱스를 표현하지 못한다 — WebinarRegistration 과 같은 사정).
  emailNormalized  String?
  /// E.164 한 형태(+12025550147). 표기가 제각각이면 등록 확인 조회가 안 맞는다.
  phoneE164        String?
  locale           String?
  /// "online" | "onsite" — 설계 문서의 source 컬럼. CollectRecord.source 는 이미 CollectSource
  /// 관계 이름이라 충돌해서 이름을 바꿨다(DB 컬럼도 entryChannel).
  entryChannel     String?
  emailStatus      String?
  emailSentAt      DateTime?
  emailError       String?
  createdAt        DateTime  @default(now())

  source    CollectSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// 등록 확인이 전화번호로도 조회한다 — 없으면 5만 건 풀스캔.
  @@index([sourceId, phoneE164])
  // (sourceId, emailNormalized) 유니크는 **부분 인덱스**(WHERE emailNormalized IS NOT NULL)라
  // 여기 선언할 수 없다 — supabase/migrations/20260815_collect_builder.sql 에 raw SQL 로 있다.
  // Prisma 는 부분 인덱스를 표현하지 못한다(WebinarRegistration 과 같은 사정).
  @@index([sourceId, createdAt(sort: Desc)])
  @@index([projectId, createdAt])
  @@index([projectId, utmSource])
  @@index([projectId, utmMedium])
  @@index([projectId, sourceId, createdAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  sourceId    String?
  userId      String?
  action      String // "source.created" | "source.deleted" | "key.regenerated" | "record.deleted" | "record.updated" | "records.imported" | "records.cleaned" | "records.normalized" | "records.bulk_deleted"
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    CollectSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  user      User?          @relation("ActivityActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([sourceId, createdAt(sort: Desc)])
}

model Dashboard {
  id                String   @id @default(cuid())
  projectId         String
  workspaceId       String
  name              String
  description       String?
  sortOrder         Int      @default(0)
  isDefault         Boolean  @default(false)
  shareToken        String?  @unique
  shareEnabled      Boolean  @default(false)
  sharePasswordHash String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  widgets          DashboardWidget[]
  scheduledReports ScheduledReport[]

  @@index([projectId, sortOrder])
}

model DashboardWidget {
  id          String   @id @default(cuid())
  dashboardId String?
  projectId   String
  workspaceId String
  type        String
  title       String
  config      Json
  position    Int      @default(0)
  width       String   @default("half")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dashboard Dashboard? @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([dashboardId, position])
  @@index([projectId, position])
}

model ScheduledReport {
  id          String    @id @default(cuid())
  dashboardId String
  workspaceId String
  name        String
  cron        String // 예: "0 9 * * 1" (매주 월 9시)
  channel     String // "slack" | "email"
  target      String // slack webhook URL 또는 이메일 주소
  isActive    Boolean   @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
  @@index([dashboardId])
}

// 데이터 자동 보관 정책 (GDPR/개인정보 자동 삭제)
// 소스 단위로 N일 지난 레코드 자동 제거
model CollectRetentionPolicy {
  sourceId   String   @id
  retainDays Int // 0 = 영구 보관
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 워크스페이스 단위 API 토큰 (외부 도구 연동)
model ApiToken {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String // 발급한 사용자
  name        String // 사용자 지정 라벨 (예: "Zapier 연동")
  tokenHash   String    @unique // SHA-256 hash of token
  prefix      String // 토큰 앞 8자 (식별용 — 평문 토큰은 발급 직후 한 번만 표시)
  scopes      String[]  @default([]) // ["records:read", "records:write", "dashboards:read"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// 사용자 알림 환경설정 (어떤 이벤트의 인앱 알림을 받을지)
model NotificationPref {
  id        String   @id @default(cuid())
  userId    String
  eventType String // "WORKSPACE_INVITE" | "COLLECT_SUBMITTED" | "REPORT_SENT" | "ROLE_CHANGED" 등
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
}

// 프로젝트 단위 권한 (워크스페이스 권한 위에 덮어쓰기)
// 없으면 워크스페이스 권한이 그대로 적용됨.
model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      String // "VIEWER" | "EDITOR" | "ADMIN"
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model UTMLink {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  createdById String
  name        String?
  url         String
  utmSource   String
  utmMedium   String
  utmCampaign String
  utmTerm     String?
  utmContent  String?
  fullUrl     String
  shortUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model ShortLink {
  id          String   @id @default(cuid())
  code        String   @unique
  longUrl     String
  workspaceId String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([createdById, createdAt(sort: Desc)])
}

model Webinar {
  id               String    @id @default(cuid())
  workspaceId      String
  projectId        String
  name             String
  slug             String    @unique
  description      String?
  liveStartAt      DateTime
  liveEndAt        DateTime
  signupDeadline   DateTime
  theme            Json // { accentColor, bgColor, surfaceColor, textColor, font, borderRadius, bgEffect }
  config           Json // { youtubeId, calendarUrl, surveyUrl, etc. }
  statusOverride   String? // 수동 상태 오버라이드: "registration" | "live" | "ended" | null(일정 기반 자동)
  // 실제로 방송을 끝낸 시각 — statusOverride 가 "ended" 로 넘어간 순간. 예정 종료(liveEndAt)와 다를 수 있다.
  // 참여 점수의 분모(평가 기준 길이)와 체류 상한이 이 값을 쓴다: 120분 예정인데 50분만 송출하면
  // 끝까지 본 시청자가 예정 길이 기준으로는 54점 웜에 갇힌다(실제 송출 기준 74점 핫). webinar-scoring 참고.
  // "ended" 에서 벗어나면(재개) null 로 되돌린다.
  broadcastEndedAt DateTime?
  components       Json? // 임베드 컴포넌트 설정 { heroButton, banner, formWidget, allowLiveRegistration, entryOpenBeforeMinutes, endedMode }
  // 채팅 모더레이션 — 전용 컬럼(components 블롭이 설정탭 저장으로 덮어써지는 것 방지). 천천히모드 초·금지어·차단 등록자.
  chatSlowSec      Int       @default(0)
  chatBannedWords  String[]  @default([])
  chatBannedRegIds String[]  @default([])
  chatHideLinks    Boolean   @default(true) // 링크 자동 숨김(공개 POST에서 링크 제거) — 운영자 토글
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions           WebinarSession[]
  registrations      WebinarRegistration[]
  questions          WebinarQA[]
  announcements      WebinarAnnouncement[]
  popups             WebinarPopup[]
  polls              WebinarPoll[]
  chatMessages       WebinarChatMessage[]
  reminders          WebinarReminder[]
  tallyPushes        WebinarTallyPush[]
  surveys            WebinarSurvey[]
  embedSites         WebinarEmbedSite[]
  attendanceSegments WebinarAttendanceSegment[]
  visitStats         WebinarVisitStat[]
  popupClicks        WebinarPopupClick[]
  shareEvents        WebinarShareEvent[]
  shareClicks        WebinarShareClick[]
  // slug 는 @unique 가 이미 인덱스를 만들므로 별도 @@index 불필요 (중복 제거)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([workspaceId])
}

model WebinarSession {
  id              String  @id @default(cuid())
  webinarId       String
  number          Int
  // 유형 목록의 정본은 src/lib/webinar-sessions.ts 의 SESSION_TYPES 다(현재 5종:
  // opening | session | qa | break | closing). 여기 enum·CHECK 를 두지 않는 이유는
  // 유형 추가가 마이그레이션 없이 코드 화이트리스트만으로 끝나게 하려는 것 — 대신
  // 무결성은 CRUD 라우트가 그 상수로 검증해서 지킨다.
  type            String  @default("session")
  title           String
  speaker         String? // 연사 이름(레거시 데이터는 "이름 | 회사" 결합형일 수 있음 — 표시 시 파싱)
  speakerCompany  String? // 소속·직책 (랜딩 상세 팝업에서 이름과 분리 표시)
  speakerPhotoUrl String?
  // 세션에 붙는 조직 마크(주최·협력사, 오프닝·클로징의 브랜드). speakerPhotoUrl 과 별개다 —
  // 사진은 원형 크롭이고 로고는 잘리면 안 되므로 표시 처리가 다르다(object-fit: contain).
  logoUrl         String?
  description     String? // 세션 내용(주제 상세) — 랜딩 타임테이블을 펼치면 여기가 나온다
  speakerBio      String? // 연사 약력·경력 (랜딩 상세 팝업)
  speakerHomepage String? // 연사·소속 홈페이지 (랜딩 상세 팝업의 바로가기)
  // SNS 링크 — URL 문자열 배열. 플랫폼은 저장하지 않고 호스트로 판정한다
  // (정본: src/lib/webinar-speaker-links.ts). 라벨을 같이 저장하면 주소와 어긋난 행이 생긴다.
  speakerLinks    Json?
  startTime       String
  endTime         String

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId, number])
}

model WebinarRegistration {
  id               String    @id @default(cuid())
  webinarId        String
  name             String
  phone            String?
  email            String?
  company          String?
  department       String?
  jobTitle         String?
  industry         String?
  agreeMarketing   Boolean   @default(false)
  agreePrivacy     Boolean   @default(true)
  memo             String?
  enteredAt        DateTime?
  leftAt           DateTime?
  lastPingAt       DateTime?
  presencePingAt   DateTime?
  // 접속 시간 — heartbeat 간격을 누적한다(끊긴 구간은 제외). 화면 표시·정렬·평균의 단일 소스.
  // stayMinutes 는 leave 시점의 "입장~퇴장" 스팬이라 자리비움을 포함하는 레거시 값 — 폴백 전용.
  connectedSeconds Int       @default(0)
  // 그중 탭이 실제로 보였던 시간. 접속-포커스 차이가 "틀어놓고 듣기" 구간이다.
  focusSeconds     Int       @default(0)
  stayMinutes      Int       @default(0)
  isActive         Boolean   @default(false)
  submittedAt      DateTime  @default(now())

  // 입소문 추적 — 이 등록자의 추천 코드(공유 링크 `?ref=`)와, 누구의 추천으로 들어왔는지.
  // registrationId 를 링크에 넣으면 사칭이 가능해 별도 코드를 쓴다(webinar-share.ts 주석 참고).
  shareCode    String? @unique
  referredById String?

  // UTM 어트리뷰션 (CollectRecord와 동일 구성 — attribution-core 공용화 대비)
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  utmId            String?
  firstUtmSource   String?
  firstUtmMedium   String?
  firstUtmCampaign String?
  firstUtmTerm     String?
  firstUtmContent  String?
  firstUtmId       String?
  firstReferrer    String?
  firstSeenAt      DateTime?
  journey          Json?
  referrer         String?
  userAgent        String?
  registeredStatus String? // 등록 시점의 웨비나 상태 (registration/live 등)

  webinar            Webinar                    @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  attendanceSegments WebinarAttendanceSegment[]
  shareEvents        WebinarShareEvent[]
  // 추천인이 삭제되면 추천 관계만 끊는다(데려온 등록자는 남는다) — Cascade 면 명단이 사라진다.
  referredBy         WebinarRegistration?       @relation("WebinarReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          WebinarRegistration[]      @relation("WebinarReferral")

  @@index([webinarId, submittedAt(sort: Desc)])
  @@index([webinarId, referredById])
  // 동시 제출로 인한 중복 행 방지 — NULL 은 제외(전화만/이메일만 등록 허용),
  // 이메일은 lower() 로 대소문자 무시. Prisma 가 부분/함수 인덱스를 표현하지 못해
  // 실제 인덱스는 SQL 로 생성했다: WebinarRegistration_webinarId_phone_key,
  // WebinarRegistration_webinarId_email_lower_key (register 라우트가 P2002 를 409 로 처리).
  @@index([webinarId, phone])
  @@index([webinarId, email])
  @@index([webinarId, utmSource])
  @@index([webinarId, utmMedium])
}

model WebinarQA {
  id             String   @id @default(cuid())
  webinarId      String
  registrationId String?
  question       String
  sessionNumber  Int?
  status         String   @default("pending")
  name           String?
  company        String?
  phone          String?
  email          String?
  voteCount      Int      @default(0) // 시청자 추천 수 (추천순 정렬용)
  onScreen       Boolean  @default(false) // 화면 송출 중(웨비나당 1개 — 부분 유니크 인덱스는 마이그레이션에 존재)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  webinar Webinar         @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  votes   WebinarQAVote[]

  @@index([webinarId, createdAt(sort: Desc)])
  @@index([webinarId, status])
  // 라이브 상태(/live-state)의 추천순 정렬(voteCount DESC, createdAt ASC) 지원
  @@index([webinarId, voteCount(sort: Desc), createdAt])
}

model WebinarQAVote {
  id             String   @id @default(cuid())
  qaId           String
  registrationId String? // 등록자당 1표 (검증된 경우)
  createdAt      DateTime @default(now())

  qa WebinarQA @relation(fields: [qaId], references: [id], onDelete: Cascade)

  @@unique([qaId, registrationId])
  @@index([qaId])
}

model WebinarAnnouncement {
  id          String   @id @default(cuid())
  webinarId   String
  type        String   @default("info")
  message     String
  buttonLabel String? // 공지 CTA 버튼 (선택)
  buttonUrl   String?
  isActive    Boolean  @default(false)
  sentBy      String?
  createdAt   DateTime @default(now())

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId, isActive])
}

// 웨비나당 활성 1개 보장: DB 부분 유니크 인덱스 WebinarPopup_webinarId_active_key (Prisma DSL 미표현 → 마이그레이션 SQL 관리)
model WebinarPopup {
  id                  String   @id @default(cuid())
  webinarId           String
  type                String   @default("notice")
  title               String
  message             String?
  buttonLabel         String?
  buttonUrl           String?
  secondaryLabel      String?
  secondaryUrl        String?
  integrationType     String   @default("link")
  embedCode           String?
  tallyFormId         String?
  tallyEmojiText      String?
  tallyEmojiAnimation String?
  tallyLayout         String?
  tallyWidth          Int?
  tallyAutoClose      Int?
  dismissible         Boolean  @default(true)
  isActive            Boolean  @default(false)
  sentBy              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  webinar Webinar             @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  clicks  WebinarPopupClick[]

  @@index([webinarId, isActive])
}

// 라이브 중 CTA/팝업 버튼 클릭 이벤트 — 클릭률·리드 스코어링 집계용(신규 수집).
// popupId 는 팝업 삭제 후에도 총 클릭수 보존 위해 SetNull. registrationId 는 검증된 시청자만 신뢰.
model WebinarPopupClick {
  id             String   @id @default(cuid())
  webinarId      String
  popupId        String?
  registrationId String?
  kind           String   @default("cta") // cta | tally | cta_secondary
  createdAt      DateTime @default(now())

  webinar Webinar       @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  popup   WebinarPopup? @relation(fields: [popupId], references: [id], onDelete: SetNull)

  @@index([webinarId, createdAt])
  @@index([popupId])
}

// 아임웹 등 외부 사이트 단위 부착 지점 — 로더 /w/{id} 가 이 레코드로 해석된다.
// 전시 전환 시 activeWebinarId 만 교체하면 코드 재부착 없이 다음 웨비나가 노출된다.
model WebinarEmbedSite {
  id                 String    @id @default(cuid())
  workspaceId        String
  projectId          String
  name               String
  siteUrl            String?
  livePageUrl        String? // 아임웹 라이브 전용 페이지 URL (배너/버튼의 입장 목적지)
  allowedOrigins     String[]  @default([]) // register CORS 검증용. 빈 배열 = 전체 허용
  bannerPagePatterns String[]  @default([]) // 배너 제외/포함 경로 글로브
  activeWebinarId    String? // 현재 노출 웨비나
  lastSeenAt         DateTime? // 로더 seen 비콘이 갱신 — 어드민 "연결됨" 배지
  lastSeenOrigin     String?
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activeWebinar Webinar?  @relation(fields: [activeWebinarId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([activeWebinarId])
}

// 시청 구간 — heartbeat 가 열린 구간(endedAt)을 연장하고, 90초 무갱신 시 다음 ping 이 새 구간을 만든다.
// 시청 곡선("몇 분 지점에 몇 명")의 원천. 시청자당 보통 1~3행.
model WebinarAttendanceSegment {
  id             String   @id @default(cuid())
  webinarId      String
  registrationId String
  startedAt      DateTime
  endedAt        DateTime

  webinar      Webinar             @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  registration WebinarRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([webinarId, startedAt])
  @@index([registrationId, endedAt(sort: Desc)])
}

// 부착 페이지 방문 일별 집계 (seen 비콘이 upsert) — 퍼널의 "방문" 단계.
// utmSource/Medium 은 NULL 대신 "" 를 쓴다 (Postgres unique 의 NULL distinct 회피).
/// 공유 버튼을 누른 기록 — "누가 공유했나". 클릭당 1행(공유는 사람당 몇 번뿐이라 집계하지 않는다).
model WebinarShareEvent {
  id             String   @id @default(cuid())
  webinarId      String
  registrationId String
  surface        String // waiting | live | ended | landing (webinar-share.SHARE_SURFACES)
  channel        String // native(OS 공유 시트) | copy(링크 복사)
  createdAt      DateTime @default(now())

  webinar      Webinar             @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  registration WebinarRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([webinarId, createdAt])
  @@index([registrationId])
}

/// 추천 링크(`?ref=`)로 들어온 방문 — 일자별 집계. 방문마다 행을 만들면 공유 하나가 수천 행이 된다
/// (WebinarVisitStat 과 같은 규약: date 는 KST 자정 기준).
model WebinarShareClick {
  id        String   @id @default(cuid())
  webinarId String
  shareCode String
  date      DateTime // KST 자정 기준 일자
  clicks    Int      @default(0)

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([webinarId, shareCode, date])
  @@index([webinarId, date])
}

model WebinarVisitStat {
  id        String   @id @default(cuid())
  webinarId String
  date      DateTime // KST 자정 기준 일자
  utmSource String   @default("")
  utmMedium String   @default("")
  visits    Int      @default(0)

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([webinarId, date, utmSource, utmMedium])
}

// 실시간 투표 — 운영 콘솔에서 발행(단일 활성), 시청자 우하단 토스트로 노출.
// 집계는 옵션별 voteCount(원자적 증가) + 중복 방지는 등록자당 1표(unique)로 처리.
// 웨비나당 활성 1개 보장: DB 부분 유니크 인덱스 WebinarPoll_webinarId_active_key (Prisma DSL 미표현 → 마이그레이션 SQL 관리)
model WebinarPoll {
  id        String   @id @default(cuid())
  webinarId String
  question  String
  isActive  Boolean  @default(false) // 발행(활성) — 같은 웨비나에서 1개만 ON
  sentBy    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webinar Webinar             @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  options WebinarPollOption[]
  votes   WebinarPollVote[]

  @@index([webinarId, isActive])
}

model WebinarPollOption {
  id        String @id @default(cuid())
  pollId    String
  label     String
  order     Int    @default(0)
  voteCount Int    @default(0)

  poll  WebinarPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes WebinarPollVote[]

  @@index([pollId, order])
}

model WebinarPollVote {
  id             String   @id @default(cuid())
  pollId         String
  optionId       String
  registrationId String? // 등록자 식별 — 중복 투표 방지 키
  createdAt      DateTime @default(now())

  poll   WebinarPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option WebinarPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, registrationId]) // 등록자당 1표 (registrationId 있을 때)
  @@index([pollId])
}

// 실시간 채팅 — 라이브 중 시청자·호스트 메시지. 공개 노출 시 이름은 마스킹.
model WebinarChatMessage {
  id             String   @id @default(cuid())
  webinarId      String
  registrationId String? // 발신 등록자 (검증된 경우만)
  name           String
  message        String
  isHost         Boolean  @default(false) // 운영자(호스트) 발언
  isPinned       Boolean  @default(false) // 고정 메시지(웨비나당 1개 — 부분 유니크 인덱스는 마이그레이션에 존재)
  createdAt      DateTime @default(now())

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId, createdAt])
}

// 알림 구독 — "알림 받고 이어보기" 스위치 ON 시 등록자 이메일을 저장. 운영자가 구독자에게 발송.
model WebinarReminder {
  id             String   @id @default(cuid())
  webinarId      String
  registrationId String?
  email          String
  createdAt      DateTime @default(now())

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([webinarId, email])
  @@index([webinarId])
}

// 웨비나당 활성 1개 보장: DB 부분 유니크 인덱스 WebinarTallyPush_webinarId_active_key (Prisma DSL 미표현 → 마이그레이션 SQL 관리)
model WebinarTallyPush {
  id                   String   @id @default(cuid())
  webinarId            String
  title                String
  formId               String
  emojiText            String?
  emojiAnimation       String?
  layout               String   @default("modal")
  width                Int      @default(700)
  autoClose            Int      @default(5000)
  showOnce             Boolean  @default(true)
  doNotShowAfterSubmit Boolean  @default(true)
  memo                 String?
  isActive             Boolean  @default(false)
  sentBy               String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId, isActive])
}

// ── 자체 설문 — 종료 화면·라이브 푸시·독립 링크에서 응답 수집 ──
// questions 는 JSON: [{ id, type: 'rating'|'single'|'multiple'|'text'|'nps', title, required, options[] }]
// isActive = 라이브 푸시 활성(웨비나당 1개 — 부분 유니크 인덱스는 db execute 로 적용, P2002→409 처리)
model WebinarSurvey {
  id              String    @id @default(cuid())
  webinarId       String
  title           String
  description     String?
  questions       Json      @default("[]")
  isOpen          Boolean   @default(true) // 응답 수집 여부 — 운영자 수동 온·오프(마스터 게이트)
  opensAt         DateTime? // 시작 예약 — 이 시각 전에는 isOpen 이 켜져 있어도 받지 않는다. 비우면 즉시
  closesAt        DateTime? // 마감 예약 — 이 시각이 지나면 isOpen 과 무관하게 응답 마감. 비우면 무기한
  doneTitle       String? // 제출 완료 화면 제목 (없으면 노출면별 기본 문구)
  doneDescription String? // 제출 완료 화면 설명
  ctaLabel        String? // 종료 화면 카드의 버튼 문구 (없으면 기본: "설문 참여하기")
  showOnEnded     Boolean   @default(false) // 종료 화면 만족도 설문 카드에 연결
  isActive        Boolean   @default(false) // 라이브 푸시 중
  pushedAt        DateTime? // 마지막 발행 시각 — 시청자 재노출 키(편집으로 바뀌는 updatedAt 과 분리)
  sentBy          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  webinar   Webinar                 @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  responses WebinarSurveyResponse[]

  @@index([webinarId, isActive])
  @@index([webinarId, showOnEnded])
}

model WebinarSurveyResponse {
  id             String   @id @default(cuid())
  surveyId       String
  webinarId      String
  registrationId String? // 등록자 응답이면 연결 — NULL(익명 링크 응답)은 중복 허용
  answers        Json // { questionId: number | string | string[] }
  source         String? // 'ended' | 'live' | 'link'
  submittedAt    DateTime @default(now())

  survey WebinarSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, registrationId])
  @@index([webinarId])
  @@index([surveyId, submittedAt])
}

// ─────────────────────────────────────────────────────────────
// 대회·투표 — docs/superpowers/specs/2026-08-13-competition-voting-system-design.md
// 최상위 단위 구조는 Webinar 를 본떴다(workspace+project, slug @unique, theme/config Json,
// 수동 override). 검증된 구조라 새로 발명하지 않는다.
// ─────────────────────────────────────────────────────────────

model Competition {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String
  name        String
  slug        String  @unique
  description String?

  // 단계 — 날짜로 자동 판정하되 수동 override 가 이긴다(resolveWebinarStatus 와 같은 규칙).
  // 현장에서 "지금 접수 닫아" 같은 조작이 반드시 필요하다.
  phaseOverride  String? // "recruiting"|"prelim"|"judging"|"final"|"announced"|"closed"|null(자동)
  recruitOpenAt  DateTime?
  recruitCloseAt DateTime?

  theme         Json // accentColor·textColor·surfaceColor·borderRadius·logoUrl
  config        Json // 공고 페이지 블록 + 신청 폼 + 동의 + 완료 처리 (competition-config.ts)
  scoringConfig Json? // 대중:심사 비율·진출 n팀·동점 규칙
  showConfig    Json? // 발표 연출 (C5)

  // 한 신청자가 낼 수 있는 참가작 수. 기본 1(1팀 1작품) — 필요해지면 올린다.
  maxEntriesPerApplicant Int @default(1)

  previewToken String? @unique // 미리보기 링크 /cp/{token}
  showToken    String? @unique // 발표 화면 /show/{token}

  // 결과 발표 페이지를 공개한 시각. null 이면 결과 임베드가 "준비 중"만 보여준다.
  // 개별 수상의 revealedAt 과 다르다 — 이건 "결과 페이지 자체를 열었는가".
  resultPublishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rounds    CompetitionRound[]
  entries   CompetitionEntry[]
  judges    CompetitionJudge[]
  awards    CompetitionAward[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([workspaceId])
}

/// 예선·본선. 라운드를 행으로 두는 이유: 두 라운드의 규칙이 다르다(상한·비율·순서·식별 방식).
/// 대회에 필드를 늘리면 prelimXxx/finalXxx 가 두 벌씩 생기고 3라운드가 오면 또 늘어난다.
model CompetitionRound {
  id            String @id @default(cuid())
  competitionId String
  kind          String // "prelim" | "final"
  name          String
  sortOrder     Int    @default(0)

  // 투표 운영
  voteEnabled      Boolean   @default(false)
  voteOpenAt       DateTime?
  voteCloseAt      DateTime?
  maxVotesPerVoter Int       @default(1)
  allowVoteUndo    Boolean   @default(false)
  // "ip"|"device"|"both"|"registration" — 현장에서 ip 단독은 쓰지 않는다(공유 와이파이가 한 명으로 묶인다).
  voterIdentity    String    @default("device")
  ipVoteLimit      Int? // device 모드의 IP 보조 상한. 정상 공유망을 막지 않을 만큼 넉넉히.
  showLiveTally    Boolean   @default(false)

  // 참가작 표시 순서. random 은 방문자마다 섞되 그 사람에게는 고정된다(voterKey 파생 시드).
  entryOrder String @default("random") // "random"|"manual"|"submitted"

  // 이전 라운드 점수 이월 — 기본 끔(리셋). 나중에 켤 수 있게 구조만 열어 둔다.
  carryOverEnabled Boolean @default(false)
  carryOverPercent Int     @default(0)

  // 심사
  judgeCriteria Json? // [{ key, label, maxScore }]
  publicWeight  Int   @default(50)
  judgeWeight   Int   @default(50)
  advanceCount  Int?

  competition Competition             @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  votes       CompetitionVote[]
  judgeScores CompetitionJudgeScore[]

  @@unique([competitionId, kind])
  @@index([competitionId])
}

model CompetitionEntry {
  id            String  @id @default(cuid())
  competitionId String
  entryNo       String // 현장에서 "3번 팀"으로 부른다. cuid 는 사람이 못 읽는다.
  title         String
  teamName      String?
  summary       String? @db.Text

  data  Json // 신청 폼 응답 전체 (CollectRecord.data 와 같은 계약)
  media Json // [{ kind:"image"|"youtube", url?|videoId?, sortOrder }]

  // 검색·연락용으로 승격한 신청자 정보 (원본은 data 에도 남는다)
  contactName  String?
  contactEmail String?
  contactPhone String?

  /// 동의 기록 — WebinarRegistration.agreePrivacy/agreeMarketing 과 같은 이유로 컬럼을 둔다.
  /// 예전에는 체크박스 상태를 검증만 하고 어디에도 저장하지 않았다(마케팅 수신 동의 여부가
  /// 통째로 유실됐다) — 법률 문구 생성기로 제3자 제공 동의를 추가하며 함께 메운다.
  agreePrivacy    Boolean @default(true)
  agreeMarketing  Boolean @default(false)
  agreeThirdParty Boolean @default(false)

  status      String  @default("submitted") // submitted|approved|rejected
  isPublished Boolean @default(false) // 투표 노출 토글
  sortOrder   Int     @default(0)
  advanced    Boolean @default(false) // 본선 진출
  // 본선 진행 순서. 예선 신청 순서와 무관하게 운영자가 다시 정한다(sortOrder 를 덮어쓰면
  // 공고·예선 기록까지 뒤바뀐다). null 이면 참가번호 순으로 떨어진다.
  finalOrder  Int?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  competition Competition             @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  votes       CompetitionVote[]
  judgeScores CompetitionJudgeScore[]
  awards      CompetitionAward[]

  @@unique([competitionId, entryNo])
  @@index([competitionId, isPublished, sortOrder])
  @@index([competitionId, submittedAt])
  @@index([competitionId, advanced, finalOrder])
}

/// 대중 투표. 상한의 최종 방어선은 레이트리미터가 아니라 아래 @@unique 다 —
/// ratelimit.ts 는 Redis 가 없으면 메모리 폴백이라 서버리스에서 인스턴스마다 상한이 새어 나간다.
model CompetitionVote {
  id        String   @id @default(cuid())
  roundId   String
  entryId   String
  voterKey  String // 해시. 원본 IP·전화번호를 저장하지 않는다.
  ipHash    String? // IP 보조 상한용 별도 해시
  userAgent String?
  createdAt DateTime @default(now())

  round CompetitionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  entry CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([roundId, entryId, voterKey])
  @@index([roundId, voterKey])
  @@index([roundId, entryId])
  @@index([roundId, ipHash])
}

model CompetitionJudge {
  id            String    @id @default(cuid())
  competitionId String
  name          String
  email         String?
  affiliation   String?
  accessToken   String    @unique // 심사위원마다 다른 링크
  passwordHash  String? // 링크만으로는 열리지 않는다. hashSharePassword 재사용.
  weight        Int       @default(1)
  invitedAt     DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())

  competition Competition             @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  scores      CompetitionJudgeScore[]

  @@index([competitionId])
}

model CompetitionJudgeScore {
  id      String @id @default(cuid())
  roundId String
  entryId String
  judgeId String

  scores Json // { creativity: 27, ... }
  total  Float // 저장 시 계산 — 순위 쿼리마다 Json 을 파싱하지 않는다.

  comment   String?  @db.Text
  submitted Boolean  @default(false) // 제출 전엔 임시저장
  updatedAt DateTime @updatedAt

  round CompetitionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  entry CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  judge CompetitionJudge @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([roundId, entryId, judgeId])
  @@index([roundId, entryId])
  @@index([judgeId])
}

model CompetitionAward {
  id            String    @id @default(cuid())
  competitionId String
  entryId       String?
  name          String
  rank          Int
  description   String?
  revealedAt    DateTime?

  competition Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  entry       CompetitionEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([competitionId, rank])
}
